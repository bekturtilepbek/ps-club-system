# Postgres
POSTGRES_DB=psclub
POSTGRES_USER=psclub
POSTGRES_PASSWORD=psclub

# Core (used when running outside Docker, e.g. `uv run pytest`).
# Inside docker-compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://psclub:psclub@localhost:5432/psclub

# Telegram bot — leave empty in dev until you have a real bot from @BotFather.
# Without BOT_TOKEN the bot container starts and stays idle instead of crash-looping.
# The owner's chat_id (and the day-not-closed reminder timing) are NOT set here —
# they're `settings` table rows, edited via /admin (SQLAdmin) once the bot exists:
# owner_chat_id, day_reminder_threshold_minutes, day_reminder_interval_minutes.
BOT_TOKEN=

# TZ is the conventional container/system timezone; TIMEZONE is what core/config.py's
# Settings.timezone actually reads (pydantic-settings binds it to this exact env var name).
# Keep both in sync.
TZ=Asia/Bishkek
TIMEZONE=Asia/Bishkek

# Hall-screen login (Stage 3). The dev defaults baked into core/config.py work out
# of the box (password: "admin"). Replace both before a real deployment:
#   uv run python -m core.auth.password 'new-password'      -> ADMIN_PASSWORD_HASH
#   python -c "import secrets; print(secrets.token_hex(32))" -> SESSION_SECRET
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false

# Production (docker-compose.prod.yml) ------------------------------------------------
# POSTGRES_PASSWORD above has no default in the prod stack: set a real one.
# Set SESSION_COOKIE_SECURE=true only once the site is served over HTTPS (hybrid).
#
# Public address. ":80" = plain HTTP (local smoke test). For the real server put the
# hostname (e.g. psclub.duckdns.org) and Caddy fetches a Let's Encrypt certificate itself;
# then also set SESSION_COOKIE_SECURE=true above.
SITE_ADDRESS=:80
# Host ports Caddy publishes (change only for a local test next to other services).
HTTP_PORT=80
HTTPS_PORT=443
# Where dumps land on the host (hourly, kept 14 days).
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=14
# Optional: runs once a day with the newest dump as $1 to ship it off the machine, e.g.
#   BACKUP_UPLOAD_CMD=rclone copyto "$1" remote:psclub/$(basename "$1")
# The stock postgres:16-alpine image has no rclone — extend the backup service first.
BACKUP_UPLOAD_CMD=
